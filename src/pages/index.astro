---
import PatternEntry from "../components/PatternEntry.astro";
import Layout from "../layouts/Layout.astro";

import registryDump from "../components/registry_dump.json";
const greatSpellIds = registryDump.map((e) => e.id).sort();
---

<Layout>
  <header class="bg-gray-800 shadow-xs lg:static lg:overflow-y-visible">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="relative flex justify-between">
        <div class="min-w-0 flex-1 md:px-8 lg:px-0 xl:col-span-6">
          <div
            class="flex items-center px-6 py-4 md:mx-auto md:max-w-3xl lg:mx-0 lg:max-w-none xl:px-0"
          >
            <div class="grid w-full grid-cols-1">
              <input
                id="search"
                type="search"
                name="search"
                class="col-start-1 row-start-1 block w-full rounded-md bg-gray-800 py-1.5 pr-3 pl-10 text-base text-white outline-1 -outline-offset-1 outline-gray-600 placeholder:text-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-gray-300 sm:text-sm/6"
                placeholder="Search"
              />
              <svg
                class="pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center text-gray-300"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
                data-slot="icon"
              >
                <path
                  fill-rule="evenodd"
                  d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>
  <ul
    role="list"
    id="results"
    class="grid grid-cols-1 m-4 sm:m-6 gap-6 min-[712px]:grid-cols-2 min-[1056px]:grid-cols-3 min-[1400px]:grid-cols-4 min-[1744px]:grid-cols-5 min-[2088px]:grid-cols-6"
  >
    {greatSpellIds.map((id) => <PatternEntry id={id} />)}
  </ul>
  <template id="valhalla"></template>

  <script src="../components/search.ts"></script>
</Layout>
